# Tenant developer key from https://www.terminal3.io/claim-page (shown once)
T3N_API_KEY=
# Agent identity — any fresh 32-byte hex key (openssl rand -hex 32). Never reuse T3N_API_KEY.
AGENT_KEY=
# Demo data owner (the "customer") — another fresh 32-byte hex key
USER_KEY=
# Email gateway the contract POSTs reminders to. For a live inbox demo use a
# webhook.site URL; for production use e.g. https://api.resend.com/emails
EMAIL_ENDPOINT=
# Optional: sent as Authorization: Bearer by the contract (required by real gateways)
EMAIL_API_KEY=
# Optional: "from" field for gateways that require one
EMAIL_FROM=
